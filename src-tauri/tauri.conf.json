{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThornsTube",
  "version": "0.0.0",
  "identifier": "app.thornstube",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://localhost:9080",
    "beforeBuildCommand": "pnpm run pack:tauri",
    "beforeDevCommand": "pnpm run dev:tauri"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "title": "ThornsTube", "width": 1200, "height": 800, "minWidth": 400, "minHeight": 300 }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
